# Copia este archivo a .env y rellena los valores. Aquí solo van los NOMBRES.
# .env está en .gitignore: nunca se sube al repositorio.

# Puerto HTTP (Cloud Run lo fija automáticamente)
PORT=

# development, production o test
NODE_ENV=

# Secreto para firmar las cookies de sesión (obligatorio en producción; cadena larga y aleatoria)
SECRETO_SESION=
